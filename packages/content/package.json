{
  "name": "@ojt/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/schema/index.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./loader": "./src/loader.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schema:write": "node --experimental-transform-types --import ./scripts/ts-source-resolve.js scripts/write-json-schema.ts && prettier --write schema/task.schema.json",
    "validate": "node --experimental-transform-types --import ./scripts/ts-source-resolve.js scripts/validate.ts"
  },
  "dependencies": {
    "@ojt/board-model": "workspace:*",
    "@ojt/circuit-sim": "workspace:*",
    "@ojt/ladder-core": "workspace:*",
    "@ojt/schematic-core": "workspace:*",
    "zod": "4.6.0"
  },
  "devDependencies": {
    "@ojt/plc-dialects": "workspace:*",
    "ajv": "^8.20.0"
  }
}
