{
  "formatVersion": 1,
  "id": "d-004",
  "mode": "plc",
  "title": "PLC ワンショット回路（2級形式）",
  "grade": 2,
  "description": "黒（X0）を押した瞬間から1秒間だけ白ランプ（PL1）が点灯するワンショット回路をPLCで組みます。長押ししても1秒で消え、黄（X1）を押している間は起動しません。緑（X2）を押している間は黄ランプ（PL2）が点灯し、緑ランプ（PL3）は1秒クロック（SP2）で点滅します。PLCの出力は必ず盤のリレーを介し、PLCの電源は壁コンセントから取ってください。",
  "timeLimit": { "standardMin": 50, "cutoffMin": 60 },
  "board": {
    "boardId": "board-jipm-std",
    "socketRoles": { "S1": "CR1", "S2": "CR2", "S3": "CR3", "S4": "CR4", "S7": "CHK" }
  },
  "inventory": [{ "kind": "relay-my4n", "count": 4 }],
  "plc": { "vendor": "mitsubishi", "model": "FX5U" },
  "io": {
    "mode": "fixed",
    "wiring": "sink",
    "inputs": [
      { "x": 0, "pb": "PB1" },
      { "x": 1, "pb": "PB2" },
      { "x": 2, "pb": "PB3" }
    ],
    "outputs": [
      { "y": 0, "cr": "CR1", "pl": "PL1" },
      { "y": 1, "cr": "CR2", "pl": "PL2" },
      { "y": 2, "cr": "CR3", "pl": "PL3" }
    ]
  },
  "referenceLadder": {
    "networks": [
      {
        "id": "n1",
        "comment": "立上りで起動（停止ボタンを押している間は起動しない）",
        "cells": [
          [
            { "kind": "contact", "type": "NC", "device": { "kind": "input", "index": 1 } },
            { "kind": "contact", "type": "P", "device": { "kind": "input", "index": 0 } },
            { "kind": "coil", "type": "SET", "device": { "kind": "internal", "index": 0 } }
          ]
        ]
      },
      {
        "id": "n2",
        "comment": "1秒計時",
        "cells": [
          [
            { "kind": "contact", "type": "NO", "device": { "kind": "internal", "index": 0 } },
            {
              "kind": "timer",
              "type": "TON",
              "device": { "kind": "timer", "index": 0 },
              "presetMs": 1000
            }
          ]
        ]
      },
      {
        "id": "n3",
        "comment": "タイムアップか停止で解除",
        "cells": [
          [
            { "kind": "contact", "type": "NO", "device": { "kind": "timer", "index": 0 } },
            { "kind": "vline" },
            { "kind": "coil", "type": "RST", "device": { "kind": "internal", "index": 0 } }
          ],
          [{ "kind": "contact", "type": "NO", "device": { "kind": "input", "index": 1 } }]
        ]
      },
      {
        "id": "n4",
        "comment": "出力",
        "cells": [
          [
            { "kind": "contact", "type": "NO", "device": { "kind": "internal", "index": 0 } },
            { "kind": "coil", "type": "OUT", "device": { "kind": "output", "index": 0 } }
          ]
        ]
      },
      {
        "id": "n5",
        "comment": "点検灯（押している間だけ）",
        "cells": [
          [
            { "kind": "contact", "type": "NO", "device": { "kind": "input", "index": 2 } },
            { "kind": "coil", "type": "OUT", "device": { "kind": "output", "index": 1 } }
          ]
        ]
      },
      {
        "id": "n6",
        "comment": "点検中の点滅（1秒クロック SP2）",
        "cells": [
          [
            { "kind": "contact", "type": "NO", "device": { "kind": "input", "index": 2 } },
            { "kind": "contact", "type": "NO", "device": { "kind": "special", "index": 2 } },
            { "kind": "coil", "type": "OUT", "device": { "kind": "output", "index": 2 } }
          ]
        ]
      },
      { "id": "end", "cells": [[{ "kind": "end" }]] }
    ],
    "comments": {
      "X0": "起動押ボタン（黒）",
      "X1": "停止押ボタン（黄）",
      "M0": "ワンショットの保持",
      "T0": "ワンショット 1秒",
      "SP2": "1秒クロック"
    }
  },
  "wiringRequired": true,
  "operations": [
    { "t": 500, "target": "PB1", "action": "press" },
    { "t": 600, "target": "PB1", "action": "release" },
    { "t": 3000, "target": "PB1", "action": "press" },
    { "t": 5000, "target": "PB1", "action": "release" },
    { "t": 5500, "target": "PB3", "action": "press" },
    { "t": 6500, "target": "PB3", "action": "release" }
  ],
  "durationMs": 7000,
  "judge": { "compareSignals": ["PL1", "PL2", "PL3"] }
}
