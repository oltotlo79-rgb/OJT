        },
        "parts": {
          "minItems": 2,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "部品の識別子（課題の中で一意）。マークシートの行になります。"
              },
              "kind": {
                "type": "string",
                "enum": ["relay-my4n", "timer-h3y4"],
                "description": "部品種別（リレーかタイマ）。"
              },
              "truth": {
                "type": "string",
                "enum": [
                  "normal",
                  "coil-open",
                  "coil-layer-short",
                  "a-open",
                  "a-weld",
                  "b-open",
                  "b-weld"
                ],
                "description": "その部品の本当の状態。訓練者の解答と突き合わせます。"
              },
              "ratio": {
                "description": "レアショートのコイル抵抗の低下率（省略すると 0.65）。",
                "type": "number",
                "minimum": 0.4,
                "maximum": 0.85
              },
              "group": {
                "description": "接点の不良を入れる組（1〜4）。省略すると課題の seed と部品IDから決めます。",
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              }
            },
            "required": ["id", "kind", "truth"],
            "additionalProperties": false
          },
          "description": "トレイに並ぶ部品（2〜8個）。正常と不良を混ぜます。"
        },
        "seed": {
          "default": 0,
          "description": "接点の不良をどの組に入れるかを決める種。同じ種からは必ず同じ組になります。",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
