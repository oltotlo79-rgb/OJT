    "boardId": "board-jipm-std",
    "socketRoles": { "S1": "CR1", "S2": "CR2", "S3": "CR3", "S4": "CR4", "S7": "CHK" }
  },
  "inventory": [{ "kind": "relay-my4n", "count": 4 }],
  "plc": { "vendor": "mitsubishi", "model": "FX5U" },
  "io": {
    "mode": "fixed",
    "wiring": "sink",
    "inputs": [
