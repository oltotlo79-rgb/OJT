{
  "name": "@ojt/desktop",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/build-manual.mjs && node scripts/dev.mjs",
    "build": "node scripts/build-manual.mjs && node scripts/build.mjs",
    "start": "electron out/main/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test --project=default",
    "e2e:shots": "playwright test --project=manual-shots",
    "e2e:packaged": "playwright test --project=packaged",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist": "node scripts/copy-content.mjs && node scripts/build-manual.mjs && electron scripts/print-manual.mjs && node scripts/build.mjs && electron-builder --config electron-builder.yml && node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@ojt/board-model": "workspace:*",
    "@ojt/circuit-sim": "workspace:*",
    "@ojt/content": "workspace:*",
    "@ojt/ladder-core": "workspace:*",
    "@ojt/plc-dialects": "workspace:*",
    "@ojt/schematic-core": "workspace:*"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "1.8.0",
    "@playwright/test": "1.63.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "happy-dom": "20.14.5",
    "markdown-it": "15.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0",
    "vite": "8.3.0",
    "zustand": "5.0.15"
  }
}
